{
  "name": "building-node",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:pages && tsc -b && vite build",
    "build:pages": "node --import tsx scripts/build-lesson-media.ts && node scripts/build-curriculum-preview.mjs && node scripts/promote-homepage.mjs && npm run build:companion",
    "build:companion": "node --import tsx scripts/build-companion-corpus.ts",
    "test:companion": "node --import tsx tests/companion.test.ts",
    "test:textbook": "node --import tsx tests/textbook-content.test.mjs",
    "test:textbook:browser": "node tests/textbook-content-browser.mjs",
    "test:textbook:digital": "node tests/digital-textbook.test.mjs",
    "test:textbook:digital:browser": "node tests/digital-textbook-browser.mjs",
    "test:ui:browser": "node tests/site-ui-browser.mjs",
    "test:companion:browser": "node tests/companion-browser.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "compress-models": "node scripts/compress-models.mjs",
    "test:animation": "node --import tsx tests/animation-timeline.test.ts",
    "test:rotation-speed": "node --import tsx tests/node-rotation-speed.test.ts",
    "test:rainwater-outlets": "node --import tsx tests/straight-rainwater-outlets.test.ts",
    "test:combined-foundations": "node --import tsx tests/combined-foundations.test.ts",
    "test:coating-flashing": "node --import tsx tests/coating-parapet-flashing.test.ts",
    "test:roof-trusses": "node --import tsx tests/roof-trusses.test.ts",
    "test:passive-solar-wall": "node --import tsx tests/passive-solar-wall.test.ts",
    "test:window-wall-gap-sealing": "node --import tsx tests/window-wall-gap-sealing.test.ts",
    "test:flat-slab": "node --import tsx tests/flat-slab.test.ts",
    "test:precast-slabs": "node --import tsx tests/precast-slabs.test.ts",
    "test:pile-foundation": "node --import tsx tests/pile-foundation.test.ts",
    "test:rc-lintels": "node --import tsx tests/rc-lintels.test.ts",
    "test:training": "node --import tsx tests/training.test.ts",
    "test:training:browser": "node tests/training-browser.mjs",
    "test": "npx tsx tests/resolveNodeModelSources.test.ts && npx tsx tests/explodeLayout.test.ts && npx tsx tests/explodeRuntime.test.ts && npx tsx tests/phase6-multi-model-rotation.test.ts && node --import tsx tests/single-model-camera-fit.test.ts && node --import tsx tests/single-model-camera-follow.test.ts && npx tsx tests/phase6-camera-fit.test.ts && npx tsx tests/home-menu.test.ts && npx tsx tests/home-scene-fit.test.ts && npx tsx tests/homepage-model-fit.test.ts && npx tsx tests/nodeDetail-controls.test.ts && npx tsx tests/rotation-toggle.test.ts && npm run test:rotation-speed && npx tsx tests/interaction-fixes.test.ts && npm run test:animation && npm run test:outlines && npx tsx tests/node-definition-contract.test.ts && npx tsx tests/node-assets.test.ts && npx tsx tests/node-behavior-archetypes.test.ts && npm run test:training",
    "test:homepage-training": "node tests/homepage-training-browser.mjs",
    "test:cases:browser": "node tests/case-study-browser.mjs",
    "test:outlines": "node --import tsx tests/model-outlines.test.ts",
    "test:composite-slab": "node --import tsx tests/profiled-steel-composite-slab.test.ts",
    "test:curved-stair": "node --import tsx tests/curved-stair.test.ts",
    "test:spiral-stair": "node --import tsx tests/spiral-stair.test.ts",
    "test:dogleg-stair": "node --import tsx tests/dogleg-stair.test.ts",
    "test:coating-high-low-roof-flashing": "node --import tsx tests/coating-high-low-roof-flashing.test.ts",
    "test:handrail-wall-connections": "node --import tsx tests/handrail-wall-connections.test.ts",
    "test:stair-start": "node --import tsx tests/stair-start.test.ts",
    "test:elevator-composition": "node --import tsx tests/elevator-composition.test.ts",
    "test:wall-bearing-layout": "node --import tsx tests/wall-bearing-layout.test.ts",
    "test:frame-structure-layout": "node --import tsx tests/frame-structure-layout.test.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@tailwindcss/vite": "^4.3.1",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.21.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.0",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.1",
    "three": "^0.184.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gltf-transform/cli": "^4.4.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "playwright": "^1.61.0",
    "sharp": "^0.35.5",
    "three-stdlib": "^2.36.1",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
